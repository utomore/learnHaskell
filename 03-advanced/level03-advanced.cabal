cabal-version:      3.4
name:               level03-advanced
version:            0.1.0.0
synopsis:           Haskell 教學系列 Level 3:高級
build-type:         Simple

flag solutions
  description: 用 answers/ 的參考解答取代 exercises/ 的習題骨架
  default:     False
  manual:      True

common settings
  default-language:   GHC2024
  default-extensions: OverloadedStrings
                      OverloadedRecordDot
  ghc-options:        -Wall -Wcompat
                      -Wincomplete-uni-patterns
                      -Wincomplete-record-updates
  build-depends:      base >=4.20 && <5
                    , text
                    , containers

library
  import:          settings
  if flag(solutions)
    hs-source-dirs: answers
  else
    hs-source-dirs: exercises
  exposed-modules: Exercises.E01Phantom
                   Exercises.E02Gadts
                   Exercises.E03TypeFamilies
                   Exercises.E04DerivingVia
                   Exercises.E05Optics
                   Exercises.E06Streaming
                   Exercises.E07Performance

test-suite level03-tests
  import:         settings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:  level03-advanced
                , directory
                , filepath
                , hspec >=2.11
                , hedgehog
                , hspec-hedgehog
